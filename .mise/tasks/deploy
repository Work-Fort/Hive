#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#MISE description="Stop service, rebuild + install, restart service"
set -euo pipefail

BUILD_DIR=build
BINARY_NAME=hive
GIT_SHORT_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
VERSION="${VERSION:-dev-$GIT_SHORT_SHA}"

mkdir -p "$BUILD_DIR"
go build -ldflags "-X github.com/Work-Fort/Hive/cmd.Version=$VERSION" -o "$BUILD_DIR/$BINARY_NAME"

systemctl --user stop hive.service
install -Dm755 "$BUILD_DIR/$BINARY_NAME" "$HOME/.local/bin/$BINARY_NAME"
install -Dm644 deploy/hive.service "$HOME/.config/systemd/user/hive.service"
systemctl --user daemon-reload
systemctl --user start hive.service
systemctl --user status hive.service
